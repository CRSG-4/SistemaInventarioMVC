@model IEnumerable<SistemaInventarioMVC.Models.Usuarios>

@{
    ViewBag.Title = "Usuarios";
}

<h2>Usuarios</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<p>@Html.ActionLink("Crear nuevo usuario", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Nombre</td>
                <td>@u.Correo</td>
                <td>@(u.Activo ? "Activo" : "Inactivo")</td>
            </tr>
        }
    </tbody>
</table>