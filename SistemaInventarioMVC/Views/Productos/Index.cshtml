@model IEnumerable<SistemaInventarioMVC.Models.Producto>

@{
    ViewBag.Title = "Productos";
}

<h2>Productos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<p>@Html.ActionLink("Crear nuevo producto", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Existencia</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Codigo</td>
                <td>@p.Nombre</td>
                <td>@p.Categoria.Nombre</td>
                <td>$@p.Precio.ToString("N2")</td>
                <td>@p.Existencia</td>
                <td>@(p.Activo ? "Activo" : "Inactivo")</td>
                <td>
                    @Html.ActionLink("Detalle", "Details", new { id = p.Id }) |
                    @Html.ActionLink("Editar", "Edit", new { id = p.Id })

                    @using (Html.BeginForm("CambiarEstado", "Productos", new { id = p.Id }, FormMethod.Post, new { style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link" style="padding:0">
                            @(p.Activo ? "Desactivar" : "Activar")
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>